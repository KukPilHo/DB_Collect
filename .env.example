# 1. 공공데이터포털(data.go.kr) API 설정
# 활용신청: https://www.data.go.kr/data/15057023/openapi.do
# 인코딩된 Service Key를 입력하세요.
DATA_GO_KR_SERVICE_KEY=

# 경기도 OpenAPI 실제 호출 URL 
# (활용신청 상세 페이지에 나오는 EndPoint URL을 입력하세요. 
# 보통 https://api.odcloud.kr/api/15057023/v1/uddi:xxxxxxxx-... 형태입니다.)
GG_API_URL=

# 2. 네이버 개발자센터 API 설정 (이메일 크롤링용 검색)
# 활용신청: https://developers.naver.com/
# 애플리케이션 등록 후 Client ID, Client Secret 입력
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 이하 선택사항 ---
# 3. Google Custom Search API 설정 (선택)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# 4. SerpAPI 설정 (선택)
SERPAPI_KEY=
