# ======================================
# 600 Outbound DB 파이프라인 환경변수
# ======================================

# 공공데이터포털 (필수)
# 활용신청: https://www.data.go.kr
DATA_GO_KR_SERVICE_KEY=

# 경기도 공장등록 Open API
GG_API_URL=https://openapi.gg.go.kr/FACTRYREGISTTM

# 검색 API (이메일 enrichment용)
# 네이버: https://developers.naver.com (일 25,000회)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google Custom Search (선택, 무료 일 100쿼리)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# 옵션 (초보자는 기본값 유지 권장)
# ENRICHMENT_CONCURRENCY: 한 번에 동시에 이메일을 검색할 회사 수. 숫자가 클수록 빠르지만 API 제한에 걸릴 확률이 높습니다. 기본 5 권장.
ENRICHMENT_CONCURRENCY=5
# USER_AGENT: 웹사이트 접속 시 우리를 식별하는 브라우저 이름. 차단을 방지하기 위해 임의의 이름으로 설정합니다.
USER_AGENT=AblearnBD-Research/1.0
